{
  "name": "modaco-promotions-api",
  "version": "1.0.0",
  "private": true,
  "description": "ModaCo Promotion Management API — flash sales and serverless-style bulk ingestion",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "worker": "tsx --env-file=.env src/workers/local-runner.ts",
    "start:worker": "node --env-file=.env dist/workers/local-runner.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "gen:vendor-csv": "tsx scripts/gen-vendor-csv.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest -i",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest -i --selectProjects integration",
    "demo:flash-sale": "bash scripts/demo-flash-sale.sh",
    "demo:ingestion": "bash scripts/demo-ingestion.sh",
    "up": "node scripts/up.mjs",
    "down": "docker compose stop",
    "reset": "docker compose down -v",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "express": "^5.0.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
